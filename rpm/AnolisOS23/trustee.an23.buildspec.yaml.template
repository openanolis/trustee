version: 1

container:
  image: "openanolis/anolisos@sha256:b0067a96f6f8a02d378304bd27ef7c3081f28d75a0003e2f145bf4412001d37c"

inputs:
  source:
    url: "https://github.com/openanolis/trustee/releases/download/${GITHUB_RELEASE}/build-artifacts-v${VERSION}.tar.gz"
    targetPath: "/home/build-artifacts-v${VERSION}.tar.gz"
  goToolchain:
    url: "https://go.dev/dl/go1.26.10.linux-amd64.tar.gz"
    sha256: "ccfe7ae822d2c2f41f4fe7c956199967a4dac22d0ee0d2b2bfdb440aab3b20c5"
    targetPath: "/home/go1.26.10.linux-amd64.tar.gz"

environment:
  systemPackages:
    - name: "anolis-epao-release"
      version: "23-4.an23"
    - name: "rpm-build"
      version: "4.18.2-4.an23"
    - name: "dnf-plugins-core"
      version: "4.3.1-3.an23"
    - name: "gzip"
      version: "1.12-3.an23"
    - name: "tar"
      version: "2:1.35-1.an23"
    - name: "wget"
      version: "1.24.5-1.an23"
    - name: "make"
      version: "4.4.1-2.an23"
    - name: "git"
      version: "2.47.3-1.an23"
    - name: "libgudev-devel"
      version: "238-1.an23"
    - name: "libtdx-attest-devel"
      version: "1.22-1.an23"
    - name: "libtdx-verify-devel"
      version: "1.22-6.an23"
    - name: "openssl-devel"
      version: "3.0.12-15.an23"
    - name: "protobuf-devel"
      version: "3.19.6-6.an23"
    - name: "tpm2-tss-devel"
      version: "4.0.1-6.an23"
    - name: "perl-FindBin"
      version: "1.53-17.an23"
  tools:
    - name: "gcc"
      version: "12.3.0-13.an23"
    - name: "clang"
      version: "17.0.6-8.an23"
    - name: "perl"
      version: "5.36.3-18.an23"
    - name: "nodejs-npm"
      version: "10.9.2-1.22.16.0.1"

phases:
  prepare:
    commands:
      - |
        set -eu
        test "$(uname -m)" = x86_64
        rm -rf /usr/local/go
        tar -xzf /home/go1.26.10.linux-amd64.tar.gz -C /usr/local
        test "$(GOTOOLCHAIN=local GOROOT=/usr/local/go /usr/local/go/bin/go env GOVERSION)" = go1.26.10
      - curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain 1.88.0 && ln -sf /root/.cargo/bin/cargo /usr/local/bin/cargo && ln -sf /root/.cargo/bin/rustc /usr/local/bin/rustc
      - mkdir -p /home/rpmbuild/{BUILD,BUILDROOT,RPMS,SOURCES,SPECS,SRPMS}
      - tar -xzf "/home/build-artifacts-v${VERSION}.tar.gz" -C /home/rpmbuild/SOURCES/
      - tar -xzf /home/rpmbuild/SOURCES/trustee-${VERSION}.tar.gz -C /home/rpmbuild/SPECS --strip-components=2 trustee-${VERSION}/rpm/trustee.spec
  build:
    commands:
      - GOTOOLCHAIN=local GOROOT=/usr/local/go PATH=/usr/local/go/bin:$PATH rpmbuild --define "_topdir /home/rpmbuild" --define 'with_rustup 1' --define 'with_go_toolchain 1' -ba /home/rpmbuild/SPECS/trustee.spec

outputs:
  - path: /home/rpmbuild/SRPMS/trustee-${VERSION}-${RELEASE}.an23.src.rpm
  - path: /home/rpmbuild/RPMS/x86_64/trustee-${VERSION}-${RELEASE}.an23.x86_64.rpm
  - path: /home/rpmbuild/RPMS/x86_64/trustee-frontend-${VERSION}-${RELEASE}.an23.x86_64.rpm
  - path: /home/rpmbuild/RPMS/x86_64/attestation-challenge-client-${VERSION}-${RELEASE}.an23.x86_64.rpm
